#include <iostream>
 #include <string>
using namespace std;
class Employee
{
private:
    int ID;
    string FirstName;
    string LastName;
    string title;
    string email;
    string salary;
    string Department;
    string phone;
public:
    Employee(int id, const string& first, const string& last,const string& ttl, const string& mail, const string& sal,const string&dep,const string&pho):
        ID(id), FirstName(first), LastName(last), email(mail), phone(pho),title(ttl), salary(sal), Department(dep)
    {
        
    }
    int getID() const 
    { 
        return ID; 
    }
    void settitle(const string& ttl)
    {
        title = ttl;
    }
    string gettitle() const
    {
        return title;
    }
    void setsalary(const string& sal)
    {
        salary = sal;
    }
    string getsalary() const
    {
        return salary;
    }
    void setdepartment(const string& dep)
    {
        Department = dep;
    }
    string getdepartment() const
    {
        return Department;
    }
    void  setfirstname(const string& first)
    {
        FirstName = first;
    }
    string getfirstname() const
    {
        return FirstName;
    }
    void setlastname(const string& last)
    {
        LastName = last;
    }
    string getlastname() const
    {
        return LastName;
    }
    
    string getfullname() const
    {
        return FirstName+" " + LastName;
    }
    void setemail(const string& mail)
    {
        email = mail;
    }
    string getemail() const
    {
        return email;
    }
    void setphone(const string& mobile)
    {
        phone = mobile;
    }
    string getphone() const
    {
        return phone;
    }

    void print() const
    {
        cout << endl << endl;
        cout << "Info" << endl;
        cout<<"------------------------------"<<endl;
        cout << "ID         : " << ID << endl;
        cout <<"First Name  : " << FirstName << endl;
        cout << "Last Name  : " << LastName << endl;
        cout << "Full Name  : " << getfullname() << endl;
        cout << "Email      : " << email << endl;
        cout << "Phone      : " << phone << endl;
        cout<< "Title      : " << title << endl;
        cout<< "Salary     : " << salary << endl;
        cout<< "Department : " << Department << endl;

        cout<<"------------------------------"<<endl<<endl;
    }
    void sendemail(const string& subject, const string& message) const
    {
        cout << "the following message sent successfully to email :"<<email;
        cout << "\nSubject : " << subject;
        cout << "\nBody : " << message<<"\n";

    }
   void sendSMS(const string& message) const
    {
       cout << "\nthe following SMS sent successfully to phone :\n"<<phone<<endl;
       cout<<message<<endl<<endl;
    }
    
};


int main()
{
    Employee Employee1(10, "Zainab", "Yahya", "Software Engineer", "zainbyahya@gmail.com", "$70,000", "AI", "0110000000");

    Employee1.print();
    Employee1.sendemail("Meeting Reminder", "Don't forget about the meeting tomorrow at 10 AM.");
    Employee1.sendSMS("Hello,Zainab!");
}

