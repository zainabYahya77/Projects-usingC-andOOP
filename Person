#include <iostream>
 #include <string>
using namespace std;
class clsperson
{
private:
    int ID;
    string FirstName;
    string LastName;
    string email;
    string phone;
public:
    clsperson(int id, const string& first, const string& last, const string& mail, const string& mobile):
        ID(id), FirstName(first), LastName(last), email(mail), phone(mobile)
    {
        
    }
    int getID() const 
    { 
        return ID; 
    }
    void  setfirstname(const string& first)
    {
        FirstName = first;
    }
    string getfirstname() const
    {
        return FirstName;
    }
    void setlastname(const string& last)
    {
        LastName = last;
    }
    string getlastname() const
    {
        return LastName;
    }
    
    string getfullname() const
    {
        return FirstName+" " + LastName;
    }
    void setemail(const string& mail)
    {
        email = mail;
    }
    string getemail() const
    {
        return email;
    }
    void setphone(const string& mobile)
    {
        phone = mobile;
    }
    string getphone() const
    {
        return phone;
    }
    void print() const
    {
        cout << endl << endl;
        cout << "Info" << endl;
        cout<<"------------------------------"<<endl;
        cout << "ID         : " << ID << endl;
        cout <<"First Name  : " << FirstName << endl;
        cout << "Last Name  : " << LastName << endl;
        cout << "Full Name  : " << getfullname() << endl;
        cout << "Email      : " << email << endl;
        cout << "Phone      : " << phone << endl<<endl;

        cout<<"------------------------------"<<endl;
    }
    void sendemail(const string& subject, const string& message) const
    {
        cout << "the following message sent successfully to email :"<<email;
        cout << "\nSubject : " << subject;
        cout << "\nBody : " << message<<"\n";

    }
   void sendSMS(const string& message) const
    {
       cout << "\nthe following SMS sent successfully to phone :\n";
       cout<<message<<endl<<endl;
    }
    
};


int main()
{
    clsperson person1(10,"Zainab","Yahya","zainbyahya&&77@gmail.com","0110000000");
    person1.print();
    person1.sendemail("Hi Zainab!","How are you? ");
    person1.sendSMS("How are you?");

    
}

