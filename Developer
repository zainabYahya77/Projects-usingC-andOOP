    {
        return department;
    }
    void settitle(const string& titl)
    {
        title = titl;
    }
    string gettitle() const
    {
        return title;
    }
    void setsalary(float sal)
    {
        salary = sal;
    }
    float getsalary() const
    {
        return salary;
    }
    void print() const
    {
        cout << "\nInfo:";
